rules_version = '2';

// ---------------------------------------------------------------------------
// Firestore 安全規則 — Scrum Project（與線上部署一致）
//
// 設計重點：
//   - 預設：登入才能讀寫（catch-all）。
//   - lineUsers：允許未登入寫入（LINE webhook 註冊使用者）。
//   - lineSchedule：允許未登入讀取（LINE 定時推播 cron 需讀排程）。
//   - sprints：允許未登入「唯讀」，讓 cron 能即時讀取 sprint 產生工作日誌；
//     寫入仍受 catch-all 保護（需登入）。Firestore 規則為「任一條允許即放行」，
//     故此條只『新增』讀取權限，不影響其他集合與寫入保護。
//
// 部署：Firebase Console → Firestore Database → 規則 → 貼上 → 發布(Publish)
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    match /lineUsers/{userId} {
      allow write: if true;
    }
    match /lineSchedule/{userId} {
      allow read: if true;
    }
    match /sprints/{sprintId} {
      allow read: if true;
    }
  }
}
